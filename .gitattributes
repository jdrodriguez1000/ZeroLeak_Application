# Normalizar finales de línea: Git usa LF en el repositorio
# y hace checkout con los finales nativos del SO.
* text=auto

# Archivos de texto que siempre deben usar LF
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Scripts de Windows deben conservar CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Archivos binarios: no tocar
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
